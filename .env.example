# DigitalOcean App Platform backend (shared by Customer / Seller / Admin / Mobile)
NEXT_PUBLIC_API_BASE_URL=https://swaroop-backend-xzwkz.ondigitalocean.app/api/v1
# Local dev against the deployed backend (it rejects CORS from localhost):
#   API_PROXY_TARGET=https://swaroop-backend-xzwkz.ondigitalocean.app
#   NEXT_PUBLIC_API_BASE_URL=/api/v1
# Public API URL only. Never put DATABASE_URL, JWT secrets, or R2 keys here.

# Seller WebApp origin used in seller-manager invitation links (/accept-invite).
# Required in production; without it invite links fall back to localhost:3003.
NEXT_PUBLIC_SELLER_APP_URL=https://swaroop-seller-webapp.vercel.app
