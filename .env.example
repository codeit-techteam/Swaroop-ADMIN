# PolyStoreX Admin — environment TEMPLATE (safe to commit)
#
# Local:  cp .env.example .env.local
# Production: set the same keys in Vercel / host secrets.
# Do not put DATABASE_URL, JWT secrets, R2 keys, or other server credentials here.

NEXT_PUBLIC_API_BASE_URL=https://your-api-host.example.com/api/v1

# Local CORS workaround (leave unset in production):
# API_PROXY_TARGET=https://your-api-host.example.com
# NEXT_PUBLIC_API_BASE_URL=/api/v1

NEXT_PUBLIC_SELLER_APP_URL=https://seller.polystorex.com
